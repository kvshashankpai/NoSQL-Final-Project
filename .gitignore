# NASA source datasets (keep locally; do not commit)
data/raw/*
!data/raw/.gitkeep

# Processed data and temporary working files
data/processed/*
!data/processed/.gitkeep
data/work/

# Generated run outputs and logs
results/
outputs/
logs/
runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Java
*.class
target/

# Environment and secrets
.env
.env.*
!.env.example

# IDE and operating system
.idea/
.vscode/
.DS_Store

# Temporary files
*.tmp
*.log
