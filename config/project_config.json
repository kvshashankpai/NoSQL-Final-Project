{
  "project": "DAS839_NoSQL_Final_Project",
  "dataset": {
    "name": "NASA_HTTP_Web_Server_Logs",
    "input_files": [
      "data/raw/NASA_access_log_Jul95",
      "data/raw/NASA_access_log_Aug95"
    ],
    "input_order": [
      "NASA_access_log_Jul95",
      "NASA_access_log_Aug95"
    ],
    "encoding": "ISO-8859-1",
    "record_definition": "One physical line per input record"
  },
  "batching": {
    "default_batch_size": 1000000,
    "batch_id_start": 1,
    "batch_id_rule": "floor((record_number - 1) / batch_size) + 1",
    "owner": "Selected backend adapter",
    "record_numbering": "Continuous across input files",
    "include_final_partial_batch": true,
    "temporary_directory": "data/work",
    "central_controller_creates_batches": false
  },
  "pipelines": {
    "execution_mode": "Exactly one selected pipeline per run",
    "adapters": [
      {
        "name": "Pig",
        "directory": "pipelines/pig",
        "launcher": null
      },
      {
        "name": "MapReduce",
        "directory": "pipelines/mapreduce",
        "launcher": null
      },
      {
        "name": "MongoDB",
        "directory": "pipelines/mongodb",
        "launcher": null
      },
      {
        "name": "Hive",
        "directory": "pipelines/hive",
        "launcher": null
      }
    ],
    "adapter_cli": {
      "batch_size": "--batch-size",
      "output_directory": "--output-dir",
      "input_file": "--input",
      "input_argument_rule": "Repeat --input for each file in the configured order"
    }
  },
  "database": {
    "type": "PostgreSQL",
    "database_name": "nosql_final_project",
    "purpose": "Common reporting and execution metadata storage",
    "minimum_version": 15
  },
  "frontend": {
    "framework": "Streamlit"
  },
  "controller": {
    "language": "Python",
    "responsibilities": [
      "Pipeline selection and orchestration",
      "Run ID generation",
      "Runtime measurement",
      "Adapter invocation",
      "Output validation",
      "Transactional PostgreSQL loading"
    ]
  },
  "output": {
    "format": "JSONL",
    "encoding": "UTF-8",
    "files": [
      "batches.jsonl",
      "daily_traffic.jsonl",
      "top_resources.jsonl",
      "hourly_errors.jsonl",
      "malformed_samples.jsonl"
    ],
    "whole_run_batch_id": null,
    "malformed_sample_limit": 100,
    "optional_files": [
      "phase_timings.jsonl"
    ],
    "malformed_reason_codes": [
      "BLANK_LINE",
      "BAD_STRUCTURE",
      "BAD_HOST",
      "BAD_TIMESTAMP",
      "BAD_STATUS",
      "BAD_BYTES"
    ]
  },
  "queries": [
    {
      "id": "Q1_Daily_Traffic_Summary",
      "output_file": "daily_traffic.jsonl",
      "table": "q1_daily_traffic",
      "columns": [
        "log_date",
        "status_code",
        "request_count",
        "total_bytes"
      ]
    },
    {
      "id": "Q2_Top_Requested_Resources",
      "output_file": "top_resources.jsonl",
      "table": "q2_top_resources",
      "top_n": 20,
      "extra_columns": [
        "rank"
      ],
      "columns": [
        "resource_path",
        "request_count",
        "total_bytes",
        "distinct_host_count"
      ]
    },
    {
      "id": "Q3_Hourly_Error_Analysis",
      "output_file": "hourly_errors.jsonl",
      "table": "q3_hourly_errors",
      "error_status_range": [
        400,
        599
      ],
      "columns": [
        "log_date",
        "log_hour",
        "error_request_count",
        "total_request_count",
        "error_rate",
        "distinct_error_hosts"
      ]
    }
  ]
}
